# ── IZ Play Super Node ──
# Copie para .env e ajuste. NUNCA versione o .env (segredos).

# Quantidade de canais mantidos ativos (comece baixo no VPS de 4GB!)
SUPERNODE_TOP_N=5
# Intervalo de consulta ao top-channels (ms)
SUPERNODE_POLL_MS=60000
# Tempo fora do Top-N antes de liberar o canal (ms) — 5 min
SUPERNODE_DROP_GRACE_MS=300000
# Teto de conexoes simultaneas (PROTEJA o max_connections da sua conta!)
SUPERNODE_MAX_CONCURRENT=5

# Fonte dos canais mais assistidos. Aceita:
#  a) endpoint do gateway (spec):  http://gateway/gateway/top-channels
#  b) painel direto:               http://209.14.85.55/api/client/home
SUPERNODE_TOP_CHANNELS_URL=http://gateway/gateway/top-channels
SUPERNODE_FEED_TOKEN=

# Conta Xtream DEDICADA que o super node usa para abrir os streams.
# ATENCAO: precisa permitir >= SUPERNODE_TOP_N conexoes simultaneas.
XTREAM_HOST=http://cxst.shop
XTREAM_USER=
XTREAM_PASS=
# P2P so funciona em HLS segmentado -> use m3u8
SUPERNODE_STREAM_EXT=ts

# Converte a origem MPEG-TS em HLS no gateway da proxy antes de entrar no P2P.
SUPERNODE_MEDIA_GATEWAY_URL=http://184.154.245.38:8080/video-gateway
SUPERNODE_MEDIA_GATEWAY_TOKEN=

# SwarmCloud — MESMOS valores dos clientes (p/ entrar no MESMO swarm)
SWARM_APP_ID=web.izplay.tv
SWARM_TOKEN=DkwaY5bvR
SWARM_TRACKER_ZONE=us
SUPERNODE_SDK_URL=https://web.izplay.tv/player/vendor/swarmcloud-hls.min.js

# Chromium headless
SUPERNODE_HEADLESS=true

# Porta do endpoint de status/metricas (GET /status, /healthz)
SUPERNODE_STATUS_PORT=9099
