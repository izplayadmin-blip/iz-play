NODE_ENV=production

# Painel
PANEL_PORT=3000
PANEL_USER=admin
PANEL_PASS=troque-por-uma-senha-longa
PANEL_ALLOWED_ORIGINS=https://izplay.tv
PANEL_TRUST_PROXY=1

# XuiOne Admin API (somente leitura; nunca exponha estes valores no frontend)
XUI_BASE_URL=http://SEU-IP-XUIONE
XUI_ACCESS_CODE=SEU-ACCESS-CODE
XUI_API_KEY=SUA-API-KEY
# HTTP sem TLS deve ser habilitado explicitamente. Prefira HTTPS quando disponível.
XUI_ALLOW_INSECURE_HTTP=false
XUI_TIMEOUT_MS=8000
XUI_SYNC_INTERVAL_MS=60000

# Health check da proxy remota
PROXY_HEALTH_PATH=/health

# Feed privado XuiOne -> Super Node Top 10
SUPERNODE_FEED_TOKEN=gere-um-token-aleatorio-longo
SUPERNODE_STATUS_URL=http://209.14.85.55:9099

# Gateway de mídia
GATEWAY_PORT=4100
GATEWAY_TOKEN=gere-um-token-aleatorio-longo
GATEWAY_ALLOWED_ORIGINS=https://izplay.tv
GATEWAY_ALLOWED_HOSTS=cxst.shop
GATEWAY_MAX_TRANSCODES=2
GATEWAY_HLS_ROOT=/tmp/iz-gateway-hls

# Rota protegida WireGuard configurada no sistema operacional da VPS
VPN_INTERFACE=wg0
VPN_LABEL=Rota protegida Brasil

# Configuração pública enviada ao player
APP_VERSION=2.1.0
PUBLIC_GATEWAY_URL=/video-gateway
PUBLIC_TELEMETRY_URL=/control/api
SWARM_CLOUD_ENABLED=false
SWARM_CLOUD_SDK_URL=/player/vendor/swarmcloud-hls.min.js
SWARM_CLOUD_TOKEN=
SWARM_CLOUD_APP_ID=
