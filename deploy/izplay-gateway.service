[Unit]
Description=IZ Play v2.1 Media Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/izplay-v2.1/gateway
EnvironmentFile=/etc/izplay/gateway.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp/iz-gateway-hls
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
