[Unit]
Description=IZ Play v2.1 Catalog Gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/izplay-v2.1/catalog-gateway
EnvironmentFile=/etc/izplay/catalog-gateway.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
User=www-data
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
